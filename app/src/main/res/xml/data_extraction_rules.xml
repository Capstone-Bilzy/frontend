<?xml version="1.0" encoding="utf-8"?>
<!--
   데이터 추출 규칙 (API 31+). 클라우드 백업과 기기 간 이전 모두에서
   인증 토큰(DataStore "auth")을 제외해 JWT 평문이 외부로 나가지 않게 한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
