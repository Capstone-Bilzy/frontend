<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1130">

    <!-- Logo -->
    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bilzy"
        android:textColor="#A5A6F6"
        android:textStyle="bold|italic"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginStart="20dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Back + title -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="정산 결과"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Summary card -->
            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_summary_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- "N명 참여" chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_role_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_person"
                        app:tint="#BEBEF7"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6명 참여"
                        android:textColor="#BEBEF7"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="강남역 저녁 정산 · 1차"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="총 결제 금액"
                    android:textColor="#BEBEF7"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="310,000원"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Avatar row + date -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_alignParentStart="true">

                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_role_chip" android:layout_marginEnd="-8dp" />
                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_role_chip" android:layout_marginEnd="-8dp" />
                        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_avatar_circle" />
                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="+3" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center" android:background="@drawable/bg_avatar_circle" android:layout_marginStart="-8dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="2026.04.24"
                        android:textColor="#8888BB"
                        android:textSize="12sp" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Per-person breakdown title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="참여자 정산 내역"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Person cards (hardcoded sample) -->

            <!-- Person 1: 정민지 (나) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_person_card"
                android:padding="14dp"
                android:layout_marginBottom="8dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_alignParentStart="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="정민지" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="나" android:textColor="#A5A6F6" android:textSize="11sp" android:background="@drawable/bg_role_chip" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="48,150원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 계란찜, 된장찌개, 사이다, 주류" android:textColor="#8888BB" android:textSize="11sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="냉면 -7,500원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="공기밥 -1,000원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Person 2: 김민준 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_person_card" android:padding="14dp" android:layout_marginBottom="8dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="김민준" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="41,650원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 냉면, 공기밥, 계란찜, 된장찌개" android:textColor="#8888BB" android:textSize="11sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="주류 -13,200원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="사이다 -3,000원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Person 3: 이서연 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_person_card" android:padding="14dp" android:layout_marginBottom="8dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="이서연" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="51,950원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 냉면, 공기밥, 계란찜, 된장찌개, 주류" android:textColor="#8888BB" android:textSize="11sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="사이다 -3,000원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Person 4: 박현우 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_person_card" android:padding="14dp" android:layout_marginBottom="8dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="박현우" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="47,050원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 냉면, 공기밥, 주류" android:textColor="#8888BB" android:textSize="11sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="계란찜 -2,400원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="된장찌개 -2,400원" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_chip_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Person 5: 최지수 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_person_card" android:padding="14dp" android:layout_marginBottom="8dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="최지수" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="60,600원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 냉면, 공기밥, 계란찜, 된장찌개, 사이다, 주류" android:textColor="#8888BB" android:textSize="11sp" />
            </LinearLayout>

            <!-- Person 6: 강승호 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_person_card" android:padding="14dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="강승호" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="60,600원" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </RelativeLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="삼겹살, 냉면, 공기밥, 계란찜, 된장찌개, 사이다, 주류" android:textColor="#8888BB" android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom button -->
    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="36dp"
        android:text="정산 완료하기"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_button_dark"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
