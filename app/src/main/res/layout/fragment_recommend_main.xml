<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tv_recommend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="FOR YOU (추천)"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- MUSIC -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            app:layout_constraintEnd_toStartOf="@+id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_recommend_title">

            <View
                android:id="@+id/bg_music_circle"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_recommend_music"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_music_img"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:src="@null"
                android:scaleType="centerCrop"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/bg_music_circle"
                app:layout_constraintEnd_toEndOf="@id/bg_music_circle"
                app:layout_constraintStart_toStartOf="@id/bg_music_circle"
                app:layout_constraintTop_toTopOf="@id/bg_music_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MUSIC"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bg_music_circle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- MOVIE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_movie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_center"
            app:layout_constraintTop_toTopOf="@id/card_music">

            <View
                android:id="@+id/bg_movie_circle"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_recommend_movie"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_movie_img"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:src="@null"
                android:scaleType="centerCrop"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/bg_movie_circle"
                app:layout_constraintEnd_toEndOf="@id/bg_movie_circle"
                app:layout_constraintStart_toStartOf="@id/bg_movie_circle"
                app:layout_constraintTop_toTopOf="@id/bg_movie_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MOVIE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bg_movie_circle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- BOOK -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toStartOf="@+id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_music"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/bg_book_circle"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_recommend_book"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_book_img"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:src="@null"
                android:scaleType="centerCrop"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/bg_book_circle"
                app:layout_constraintEnd_toEndOf="@id/bg_book_circle"
                app:layout_constraintStart_toStartOf="@id/bg_book_circle"
                app:layout_constraintTop_toTopOf="@id/bg_book_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BOOK"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bg_book_circle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SPACE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_space"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_center"
            app:layout_constraintTop_toTopOf="@id/card_book"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/bg_space_circle"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_recommend_space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_space_img"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:src="@null"
                android:scaleType="centerCrop"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/bg_space_circle"
                app:layout_constraintEnd_toEndOf="@id/bg_space_circle"
                app:layout_constraintStart_toStartOf="@id/bg_space_circle"
                app:layout_constraintTop_toTopOf="@id/bg_space_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="SPACE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bg_space_circle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
