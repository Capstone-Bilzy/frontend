<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1133">

    <!-- 헤더: ← 스캔 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="스캔"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 헤더 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF" />

    <!-- 뷰파인더 영역 (flex 공간) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 좌상단 코너 -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_corner_tl" />

        <!-- 우상단 코너 -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_corner_tr" />

        <!-- 좌하단 코너 -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_corner_bl" />

        <!-- 우하단 코너 -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_corner_br" />

        <!-- 중앙 안내 아이콘 + 텍스트 -->
        <LinearLayout
            android:id="@+id/guideCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_scan"
                app:tint="#555588" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="정산해야 하는 영수증의\n결제 정보가 나오게 찍어주세요"
                android:textColor="#666699"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 하단 컨트롤 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="36dp">

        <!-- 갤러리 / 셔터 버튼 행 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:paddingStart="52dp"
            android:paddingEnd="52dp">

            <!-- 갤러리 (흰 사각형) -->
            <FrameLayout
                android:id="@+id/btnGallery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <!-- 셔터 버튼 (라벤더 링 + 흰 원) -->
            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_shutter_ring" />

                <View
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter" />

            </FrameLayout>

        </RelativeLayout>

        <!-- 모드 라벨 행 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="52dp"
            android:paddingEnd="52dp">

            <!-- QR 스캔 (왼쪽, 비활성) -->
            <TextView
                android:id="@+id/tabQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="QR 스캔"
                android:textColor="#606090"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- 영수증 스캔 (중앙, 활성): 텍스트 → ▲ 순서 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true">

                <TextView
                    android:id="@+id/tabReceipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="영수증 스캔"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="#A5A6F6"
                    android:textSize="8sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
