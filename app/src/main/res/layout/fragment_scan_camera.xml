<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BlurTarget: 사진 접근 모달(photoAccessOverlay)이 이 안의 실제 카메라 화면을 블러해서 보여줄 수 있게 한다.
         모달을 별도 DialogFragment(다른 Window)로 뒀을 때는 BlurView가 캡처를 못 해서, 같은 화면(같은 Window) 안의
         오버레이로 바꿨다. -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_dark">

            <!-- 헤더: ← 스캔 -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="70dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_back"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="스캔"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textFontWeight="500"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/roundBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_green"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_green" />

                    <TextView
                        android:id="@+id/tvRoundBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1차"
                        android:textColor="#6ADB74"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textFontWeight="600" />

                </LinearLayout>

            </LinearLayout>

            <!-- 헤더 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF" />

            <!-- 뷰파인더 영역 (flex 공간) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- CameraX 프리뷰 (배경). implementationMode=compatible(TextureView)로 둬야
                     갤러리 버튼을 눌렀을 때 뒤에서 BlurView가 이 화면을 캡처해 블러할 수 있다
                     — 기본 SurfaceView는 별도 하드웨어 레이어라 캡처가 안 된다. -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:implementationMode="compatible" />

                <!-- 좌상단 코너 -->
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="27dp"
                    android:src="@drawable/ic_corner_tl" />

                <!-- 우상단 코너 -->
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="23dp"
                    android:layout_marginTop="27dp"
                    android:src="@drawable/ic_corner_tr" />

                <!-- 좌하단 코너 -->
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="23dp"
                    android:layout_marginBottom="11dp"
                    android:src="@drawable/ic_corner_bl" />

                <!-- 우하단 코너 -->
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="23dp"
                    android:layout_marginBottom="11dp"
                    android:src="@drawable/ic_corner_br" />

                <!-- 중앙 안내 아이콘 + 텍스트 -->
                <LinearLayout
                    android:id="@+id/guideCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:translationY="35dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="94dp"
                        android:layout_height="85dp"
                        android:src="@drawable/ic_scan"
                        app:tint="#555588" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="29dp"
                        android:text="정산해야 하는 영수증의\n결제 정보가 나오게 찍어주세요"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textFontWeight="300"
                        android:lineHeight="24sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- 하단 컨트롤 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="11dp"
                android:paddingBottom="30dp">

                <!-- 갤러리 / 셔터 버튼 행 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:paddingStart="23dp"
                    android:paddingEnd="23dp">

                    <!-- 갤러리 (흰 사각형) -->
                    <FrameLayout
                        android:id="@+id/btnGallery"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- 셔터 버튼 (라벤더 링 + 흰 원) -->
                    <FrameLayout
                        android:id="@+id/btnShutter"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_centerInParent="true"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_shutter_ring" />

                        <View
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_shutter" />

                    </FrameLayout>

                </RelativeLayout>

                <!-- 모드 라벨 행 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:paddingStart="55dp"
                    android:paddingEnd="55dp">

                    <!-- QR 스캔 (왼쪽, 비활성) -->
                    <TextView
                        android:id="@+id/tabQr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="QR 스캔"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:textFontWeight="400"
                        android:maxLines="1" />

                    <!-- 영수증 스캔 (중앙, 활성): 텍스트 → ▲ 순서 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_centerHorizontal="true">

                        <TextView
                            android:id="@+id/tabReceipt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="영수증 스캔"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textFontWeight="600"
                            android:maxLines="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▲"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- 사진 접근 권한 모달 오버레이 (기본 숨김). ScanCameraModalFragment(별도 Window) 대신
         같은 화면 안의 오버레이로 둬서 BlurView가 위 blurTarget을 실시간으로 캡처/블러할 수 있게 한다. -->
    <FrameLayout
        android:id="@+id/photoAccessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_dialog"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_receipt"
                app:tint="#A5A6F6"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="'Bilzy'가 사진에\n접근하도록 허용하시겠습니까?"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="6dp"
                android:textFontWeight="500"
                android:lineHeight="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="영수증 이미지를 선택하여\n스캔할 수 있습니다."
                android:textColor="#E2E2E3"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="18dp"
                android:textFontWeight="300"
                android:lineHeight="20sp" />

            <TextView
                android:id="@+id/btnPhotoLibrary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="사진 선택..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp"
                android:textFontWeight="400" />

            <TextView
                android:id="@+id/btnFile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="모든 사진에 접근 허용"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp"
                android:textFontWeight="400" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="허용 안 함"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_button"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="16sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
