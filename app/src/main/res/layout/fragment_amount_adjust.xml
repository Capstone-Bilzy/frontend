<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <!-- Back + title row -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="금액 조정하기"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/btnSettle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="23dp"
            android:paddingEnd="23dp"
            android:paddingBottom="22dp">

            <!-- 영수증 내역 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영수증 내역"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <!-- Receipt table card -->
            <LinearLayout
                android:id="@+id/receiptTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_receipt_table"
                android:paddingStart="12dp"
                android:paddingEnd="11dp"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:layout_marginBottom="12dp">


            </LinearLayout>

            <!-- 1/N amount card (피그마: 344x108, 안쪽 12/17/20/19, 칩과 금액 줄 사이 16) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_amount_card_adjust"
                android:paddingStart="12dp"
                android:paddingTop="17dp"
                android:paddingEnd="20dp"
                android:paddingBottom="19dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp">

                <!-- "기본 1/N (6명)" chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip_purple_flat"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_people_small"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvSplitLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기본 1/N"
                        android:textColor="#E8E5FF"
                        android:textSize="13sp"
                        android:textFontWeight="600"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                </LinearLayout>

                <!-- Amount row: 숫자 30/600 + "원" 18/600 #A08CF0(아래 맞춤), 오른쪽에 차감액 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingStart="10dp">

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:gravity="center_vertical"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textFontWeight="600"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center_vertical"
                        android:text="원"
                        android:textColor="#A08CF0"
                        android:textSize="18sp"
                        android:textFontWeight="600"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDeduction"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#6ADB74"
                        android:textSize="14sp"
                        android:background="@drawable/bg_deduction_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textFontWeight="500"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

            <!-- AI recommendation section (피그마: 제목 x=28) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="AI가 영수증에서 찾은 항목"
                android:textColor="#F8FAFF"
                android:textSize="20sp"
                android:layout_marginBottom="4dp"
                android:textFontWeight="600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="내가 안 먹은 메뉴를 선택하면 그만큼 차감돼요"
                android:textColor="#AAB2FF"
                android:textSize="15sp"
                android:layout_marginBottom="19dp"
                android:textFontWeight="400" />

            <!-- 항목 칩 행 (항목 수 제한 없음, 동적 생성) — 줄바꿈. 피그마: 칩 40 높이, 가로 16·세로 17 간격 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                app:singleLine="false"
                app:chipSpacingHorizontal="16dp"
                app:chipSpacingVertical="17dp" />

            <!-- Info box (피그마: r20, 안쪽 15/13/27/12, 아이콘 상자 29 + 간격 14) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_adjust_info_box"
                android:paddingStart="15dp"
                android:paddingTop="13dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_adjust_info_icon">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_info_circle" />
                </FrameLayout>

                <!-- 한 줄 고정: 피그마 자간(-1px = -0.067em), 그래도 넘치면 글자를 줄인다 -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:text="선택한 항목은 내 금액에서 1인분 가격이 빠져요"
                    android:textColor="#D9DCFF"
                    android:textSize="15sp"
                    android:letterSpacing="-0.067"
                    android:textFontWeight="300"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeStepGranularity="0.5sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom button -->
    <TextView
        android:id="@+id/btnSettle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="36dp"
        android:text="정산 시작하기"
        android:textColor="@color/button_text"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="500"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="16sp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <!-- 헤더 구분선 (피그마 Header - TopAppBar: 아래 테두리 #6FA8FF 30%, 제목 아래 18) -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#4D6FA8FF"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
