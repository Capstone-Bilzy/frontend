<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient_dark">

    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Empty state card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_empty_history_card"
                android:paddingTop="36dp"
                android:paddingBottom="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/character_smile"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달 정산 내역이 없어요"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textFontWeight="500" />
            </LinearLayout>

            <!-- 과거 정산 내역 section title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="과거 정산 내역"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"
                android:textFontWeight="500" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPastHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="홈" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_scan" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="스캔" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_active">
            
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_history" app:tint="@color/nav_selector" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="정산내역" android:textColor="@color/nav_selector" android:textSize="12sp"
 android:textStyle="bold"
                    android:textFontWeight="600" />
            
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyPage"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mapage" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="마이페이지" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
