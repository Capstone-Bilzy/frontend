<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1130">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="36dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bilzy"
            android:textColor="#A5A6F6"
            android:textStyle="bold|italic"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="20dp" />

        <!-- Clock illustration placeholder -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_summary_card"
                android:alpha="0.6" />

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_history"
                app:tint="#A5A6F6" />

        </FrameLayout>

        <!-- "대기 중이에요" -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="대기 중이에요"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="나머지 인원의 입력을 기다리고 있어요"
            android:textColor="#BEBEF7"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Progress section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="정산 완료 현황"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="4 / 6명"
                android:textColor="#A5A6F6"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="67"
            android:progressDrawable="@drawable/bg_progress_bar"
            android:indeterminate="false"
            android:layout_marginBottom="16dp" />

        <!-- Avatar circles row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_role_chip">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="정" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_chip_green" android:padding="2dp" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="정민지" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_role_chip">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="김" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_chip_green" android:padding="2dp" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="김민준" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_role_chip">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="이" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_chip_green" android:padding="2dp" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="이서연" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_role_chip">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="박" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_chip_green" android:padding="2dp" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="박현우" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_avatar_circle">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="최" android:textColor="#8888BB" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_avatar_circle" android:padding="2dp" app:tint="#5555AA" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="최지수" android:textColor="#8888BB" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_avatar_circle">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="강" android:textColor="#8888BB" android:textSize="14sp" android:textStyle="bold" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:src="@drawable/ic_check" android:background="@drawable/bg_avatar_circle" android:padding="2dp" app:tint="#5555AA" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="강승호" android:textColor="#8888BB" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_history_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ⓘ"
                android:textColor="#8888BB"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="최지수, 강승호님이 아직 특이사항을 입력하지 않았어요\n모두 완료되면 자동으로 정산이 시작돼요"
                android:textColor="#BEBEF7"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
