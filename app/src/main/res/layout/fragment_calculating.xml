<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="36dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bilzy"
            android:textColor="#A5A6F6"
            android:textStyle="bold|italic"
            android:textSize="31sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="20dp" />

        <!-- 3D Wait illustration -->
        <ImageView
            android:layout_width="371dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wait_3d" />

        <!-- "대기 중이에요" -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="대기 중이에요"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="나머지 인원의 입력을 기다리고 있어요"
            android:textColor="#BEBEF7"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Progress section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="정산 완료 현황"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="#A5A6F6"
                android:textSize="17sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar"
            android:indeterminate="false"
            android:layout_marginBottom="16dp" />

        <!-- Avatar circles row (동적으로 채워짐) -->
        <LinearLayout
            android:id="@+id/avatarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp" />

        <!-- 준비 안 된 멤버 안내(동적으로 채워짐, 프로토타입 .bz-pending) -->
        <LinearLayout
            android:id="@+id/pendingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_history_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_history_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ⓘ"
                android:textColor="#8888BB"
                android:textSize="19sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvInfoMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI가 최적의 정산 금액을 계산하고 있어요"
                android:textColor="#BEBEF7"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
