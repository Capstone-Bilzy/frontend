<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_calculating">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="61dp"
        android:paddingBottom="36dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/logo_bilzy"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:contentDescription="@null"
        />

        <!-- 3D Wait illustration + 동전 (피그마 y120~420 영역을 한 장으로 합성, 화면 폭 전체) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-23dp"
            android:layout_marginEnd="-23dp"
            android:layout_marginTop="32dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wait_scene" />

        <!-- "대기 중이에요" -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="대기 중이에요"
            android:textColor="#F8FAFF"
            android:textSize="24sp"
            android:layout_marginTop="-15dp"
            android:textFontWeight="600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="나머지 인원의 입력을 기다리고 있어요"
            android:textColor="#AAB2FF"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:textFontWeight="400" />

        <!-- Progress section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="정산 완료 현황"
                android:textColor="#DCDAFF"
                android:textSize="18sp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="#DCDAFF"
                android:textSize="16sp"
                android:textFontWeight="500" />

        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar"
            android:indeterminate="false"
            android:layout_marginBottom="22dp" />

        <!-- Avatar circles row (동적으로 채워짐) -->
        <LinearLayout
            android:id="@+id/avatarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:layout_marginBottom="16dp" />

        <!-- 준비 안 된 멤버 안내(동적으로 채워짐, 프로토타입 .bz-pending) -->
        <LinearLayout
            android:id="@+id/pendingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_adjust_info_box"
            android:paddingStart="16dp"
            android:paddingEnd="15dp"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Info box: 기다리는 사람이 없을 때(계산이 도는 동안)만 보인다. 피그마 대기 화면에는 위 안내 상자만 있다 -->
        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_history_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ⓘ"
                android:textColor="#8888BB"
                android:textSize="19sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvInfoMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI가 최적의 정산 금액을 계산하고 있어요"
                android:textColor="#D9DCFF"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:textFontWeight="400" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
