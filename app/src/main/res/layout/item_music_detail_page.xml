<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- 앨범 아트 -->
        <ImageView
            android:id="@+id/iv_detail_album_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 제목 -->
        <!-- 제목 -->
        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            android:text="FEEL THE RHYTHM"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            app:layout_constraintEnd_toStartOf="@id/iv_detail_bookmark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_detail_album_art" />

        <!-- 북마크 버튼 (미사용) -->
        <ImageView
            android:id="@+id/iv_detail_bookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_bookmark_border"
            android:visibility="gone"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_detail_album_art" />

        <!-- 아티스트 / 장르 -->
        <TextView
            android:id="@+id/tv_detail_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• 작가 • 장르"
            android:textColor="#999999"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

        <!-- 초록 세로 바 (메모 top ~ 태그 bottom) -->
        <View
            android:id="@+id/view_accent_bar"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:background="#AACC00"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_artist"
            app:layout_constraintBottom_toBottomOf="@id/barrier_tags_bottom"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 메모 -->
        <TextView
            android:id="@+id/tv_detail_memo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="20dp"
            android:text="친구들이랑 드라이브하면서 들은 노래"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent_bar"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_artist" />

        <!-- 태그 생성 중 안내 -->
        <TextView
            android:id="@+id/tv_tag_loading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:text="태그를 출력중입니다"
            android:textColor="#888888"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent_bar"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_memo" />

        <!-- 태그 칩 그룹 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_accent_bar"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_memo">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#k-팝"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#222222"
                app:chipStrokeColor="#444444"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#힘기찬"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#222222"
                app:chipStrokeColor="#444444"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#신나는"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#222222"
                app:chipStrokeColor="#444444"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_tags_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="chip_group_tags,tv_tag_loading" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>