<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_member_waiting_gradient">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />


    <!-- 아이콘/텍스트 영역 타원형 글로우 (프로토타입 .bz-center-glow 근사) -->
    <View
        android:id="@+id/glowOval"
        android:layout_width="320dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_round_pick_glow"
        app:layout_constraintTop_toTopOf="@id/ivCharacter"
        app:layout_constraintBottom_toBottomOf="@id/tvDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Character -->
    <ImageView
        android:id="@+id/ivCharacter"
        android:layout_width="292dp"
        android:layout_height="209dp"
        android:src="@drawable/character_side"
        android:scaleType="fitCenter"
        android:layout_marginTop="59dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "멤버 합류를 기다리고 있어요" -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="멤버 합류를 기다리고 있어요"
        android:textColor="#F8FAFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivCharacter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="600" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="모두가 모이면 자동으로 정산이 시작됩니다"
        android:textColor="#AAB2FF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="400" />

    <!-- Member count progress section -->
    <LinearLayout
        android:id="@+id/progressSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="37dp"
        android:layout_marginTop="49dp"
        app:layout_constraintTop_toBottomOf="@id/tvDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Label + count row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="모인 멤버"
                android:textColor="#DCDAFF"
                android:textSize="18sp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="#DCDAFF"
                android:textSize="16sp"
                android:textFontWeight="500" />

        </RelativeLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar"
            android:indeterminate="false" />

    </LinearLayout>

    <!-- Member avatar circles (dynamically populated by MemberWaitingFragment.renderMembers()) -->
    <LinearLayout
        android:id="@+id/avatarRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/progressSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
