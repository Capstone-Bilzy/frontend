<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient_dark">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="23dp">

            <!-- Profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="35dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="23dp"
                android:layout_marginBottom="30dp">

                <!-- Profile icon + 사진 변경 버튼 (피그마 1930:1889: 32 원형, 사진 기준 왼쪽 64·위 54 — 오른쪽으로 3 삐져나옴) -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="93dp"
                    android:layout_marginEnd="20dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/ivProfileAvatar"
                        android:layout_width="93dp"
                        android:layout_height="93dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_profile_circle"
                        android:foreground="@drawable/fg_profile_ring"
                        android:padding="13dp"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:id="@+id/btnEditPhoto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="64dp"
                        android:layout_marginTop="54dp"
                        android:background="@drawable/bg_profile_camera_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="프로필 사진 변경">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_profile_camera"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 이름 + 연필 (피그마 1930:1896: 간격 12) — 이름이 길면 말줄임, 연필은 항상 이름 바로 옆 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:lineHeight="36sp"
                            android:textFontWeight="600"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnEditName"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <!-- 아이콘은 12.2dp, 누르기 쉽게 주변 11dp를 터치 영역으로 -->
                        <ImageView
                            android:id="@+id/btnEditName"
                            android:layout_width="34.2dp"
                            android:layout_height="34.2dp"
                            android:layout_marginStart="1dp"
                            android:padding="11dp"
                            android:src="@drawable/ic_edit_pencil"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="이름 변경"
                            app:layout_constraintStart_toEndOf="@id/tvUserName"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tvLoginType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textFontWeight="300"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 설정 -->
            <TextView
                android:id="@+id/menuSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="설정"
                android:textColor="#CBD5E1"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="500" />

            <!-- 계좌 정보 관리 -->
            <TextView
                android:id="@+id/menuAccount"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:text="계좌 정보 관리"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400"
                android:maxLines="1" />

            <!-- 이메일 문의 -->
            <TextView
                android:id="@+id/menuEmail"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:text="이메일 문의"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

            <!-- 로그아웃 -->
            <TextView
                android:id="@+id/menuLogout"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:text="로그아웃"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

            <!-- 회원 탈퇴 (피그마에는 없는 항목 — 사용자 지시로 추가, 2026-10-10) -->
            <TextView
                android:id="@+id/menuWithdraw"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:text="회원 탈퇴"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="74dp" android:layout_height="57dp"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="홈" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="74dp" android:layout_height="57dp"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_scan" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="스캔" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500"
 android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="74dp" android:layout_height="57dp"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_history" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="정산내역" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyPage"
            android:layout_width="74dp" android:layout_height="57dp"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_active">
            
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mapage" app:tint="@color/nav_selector" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="마이페이지" android:textColor="@color/nav_selector" android:textSize="12sp"
 android:textStyle="bold"
                    android:textFontWeight="600" />
            
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
