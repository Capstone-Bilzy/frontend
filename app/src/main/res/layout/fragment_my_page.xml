<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient_dark">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="23dp">

            <!-- Profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="35dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="23dp"
                android:layout_marginBottom="30dp">

                <!-- Profile icon -->
                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="93dp"
                    android:layout_height="93dp"
                    android:src="@drawable/character_smile"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_profile_circle"
                    android:foreground="@drawable/fg_profile_ring"
                    android:padding="13dp"
                    android:layout_marginEnd="23dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:textFontWeight="600" />

                    <TextView
                        android:id="@+id/tvLoginType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textFontWeight="300" />
                </LinearLayout>
            </LinearLayout>

            <!-- 설정 -->
            <TextView
                android:id="@+id/menuSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="설정"
                android:textColor="#CBD5E1"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="500" />

            <!-- 계좌 정보 관리 -->
            <TextView
                android:id="@+id/menuAccount"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:text="계좌 정보 관리"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

            <!-- 이메일 문의 -->
            <TextView
                android:id="@+id/menuEmail"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:text="이메일 문의"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

            <!-- 로그아웃 -->
            <TextView
                android:id="@+id/menuLogout"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center_vertical"
                android:text="로그아웃"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:textFontWeight="400" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="홈" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_scan" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="스캔" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_history" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="정산내역" android:textColor="@color/white" android:textSize="12sp"
 android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyPage"
            android:layout_width="74dp" android:layout_height="57dp" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_active">
            
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mapage" app:tint="@color/nav_selector" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="마이페이지" android:textColor="@color/nav_selector" android:textSize="12sp"
 android:textStyle="bold"
                    android:textFontWeight="600" />
            
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
