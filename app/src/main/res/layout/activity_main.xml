<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="false"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/white"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAVORIE"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp" />
        </androidx.appcompat.widget.Toolbar>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@drawable/ic_add"
            android:contentDescription="추가 버튼"
            app:backgroundTint="@color/white"
            app:tint="@color/black"
            app:maxImageSize="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="50dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAVORIE"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="30dp"/>

            <!-- HOME -->
            <TextView
                android:id="@+id/menu_home"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  HOME"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_home"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <!-- MY FAVORIE (분석 아이콘 추천: ic_analysis) -->
            <TextView
                android:id="@+id/menu_analysis"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  MY FAVORIE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_recommend"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <!-- FOR YOU (추천 아이콘 추천: ic_recommend) -->
            <TextView
                android:id="@+id/menu_recommend"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  FOR YOU"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_recommend"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <!-- MY PAGE (사람 아이콘 추천: ic_person) -->
            <TextView
                android:id="@+id/menu_mypage"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  MY PAGE"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_fashion"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <!-- SAVED RECOMMENDS -->
            <TextView
                android:id="@+id/menu_saved_recommend"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  SAVED"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_bookmark_border"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <!-- SHARE PROFILE -->
            <TextView
                android:id="@+id/menu_share"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="  SHARE PROFILE"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:drawableStart="@drawable/ic_share"
                app:drawableTint="@color/white"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>