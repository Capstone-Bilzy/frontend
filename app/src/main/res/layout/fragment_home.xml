<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient_dark">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="61dp"
            android:paddingBottom="88dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:src="@drawable/logo_bilzy"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null"
                android:layout_marginStart="28dp"
                android:layout_marginBottom="11dp"
            />

            <!-- Hero section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="33dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:id="@+id/tvHero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="오늘 모임 정산,\n자리에서 바로 끝내요"
                    android:textColor="#F6F5FF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textFontWeight="600"
                    android:lineHeight="34sp" />

                <!-- 좁은 화면(360dp 등)에서 문구를 가리지 않도록 문구 옆 남는 폭만 차지 -->
                <ImageView
                    android:layout_width="108dp"
                    android:layout_height="90dp"
                    android:layout_toEndOf="@id/tvHero"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/character_side"
                    android:scaleType="fitCenter" />

            </RelativeLayout>

            <!-- Two action cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="23dp"
                android:weightSum="2">

                <!-- Left card: 결제자 -->
                <LinearLayout
                    android:id="@+id/cardPayer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="17dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_action_card_left"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Green chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="결제자"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_card_label"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textFontWeight="600" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/ic_scan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:text="정산 시작하기"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textFontWeight="600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="영수증 스캔으로\n정산방 만들기"
                        android:textColor="#B2FFFFFF"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textFontWeight="400"
                        android:lineHeight="20sp" />

                </LinearLayout>

                <!-- Right card: 참여자 -->
                <LinearLayout
                    android:id="@+id/cardParticipant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="17dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_action_card_right"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Green chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="참여자"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_card_label"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textFontWeight="600" />

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_marginTop="18dp"
                        android:src="@drawable/joinlogo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:text="정산 참여하기"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textFontWeight="600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="QR 스캔으로\n정산방 입장"
                        android:textColor="#B2FFFFFF"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textFontWeight="400"
                        android:lineHeight="20sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Recent history -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_panel"
                android:paddingTop="20dp"
                android:paddingBottom="18dp"
                android:paddingStart="22dp"
                android:paddingEnd="24dp">

                <!-- Header row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="최근 정산 내역"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textFontWeight="600" />

                    <TextView
                        android:id="@+id/btnSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="전체보기 ›"
                        android:textColor="#B2FFFFFF"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:textFontWeight="500" />

                </RelativeLayout>

                <!-- 실데이터 리스트 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- 빈 상태 -->
                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="아직 정산 내역이 없어요"
                    android:textColor="#8080BB"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="74dp"
            android:layout_height="57dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_active">
            
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/nav_selector" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="홈"
                    android:textColor="@color/nav_selector"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textFontWeight="600" />
            
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navScan"
            android:layout_width="74dp"
            android:layout_height="57dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_scan"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="스캔"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="74dp"
            android:layout_height="57dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="정산내역"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textFontWeight="500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyPage"
            android:layout_width="74dp"
            android:layout_height="57dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mapage"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="마이페이지"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textFontWeight="500" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
