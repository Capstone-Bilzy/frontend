<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_round_pick_screen_gradient">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <!-- 헤더 (피그마 "정산방 목록": 뒤로가기 + "나의 정산 목록") -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="나의 정산 목록"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:maxLines="1" />

    </LinearLayout>

    <!-- 헤더 구분선 (피그마 Header - TopAppBar: 아래 테두리 #6FA8FF 30%, 제목 아래 18) -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#4D6FA8FF"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 아이콘/텍스트 영역 타원형 글로우 (프로토타입 .bz-center-glow 근사) -->
    <View
        android:id="@+id/glowOval"
        android:layout_width="320dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_round_pick_glow"
        app:layout_constraintTop_toTopOf="@id/ivCharacter"
        app:layout_constraintBottom_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Character illustration: Figma "참여한 차수만 정산할 수 있어요" 화면의 실제 영수증 든 캐릭터 원본 -->
    <ImageView
        android:id="@+id/ivCharacter"
        android:layout_width="229dp"
        android:layout_height="153dp"
        android:src="@drawable/character_receipt"
        android:scaleType="fitCenter"
        android:layout_marginTop="19dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="참여한 차수만 정산할 수 있어요"
        android:textColor="#F8FAFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toBottomOf="@id/ivCharacter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="600" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="차수를 선택하면 해당 금액만 정산이 진행돼요"
        android:textColor="#AAB2FF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="9dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="400" />

    <!-- 라운드(영수증) 개수만큼 동적으로 선택 카드를 생성한다 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:layout_marginTop="31dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/roundPickList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="23dp"
            android:paddingEnd="23dp"
            android:paddingBottom="16dp" />

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom button -->
    <TextView
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="36dp"
        android:text="선택 완료"
        android:textColor="@color/button_text"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="500"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="16sp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
