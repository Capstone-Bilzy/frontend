<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_qr_invite_gradient">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <!-- Back + title -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="정산방 초대"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:maxLines="1" />

    </LinearLayout>

    <!-- QR Card (윗면 중앙 반원 컷) -->
    <!-- 세로가 짧은 화면/큰 글꼴에서 카드가 하단 버튼과 겹치지 않도록 카드만 스크롤 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/qrScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/btnEnter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <com.android.bilzy.ui.widget.NotchedTicketLayout
        android:id="@+id/qrCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:notchMode="topCenter"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="52dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR코드를 스캔하여\n정산방에 들어가세요"
            android:textColor="#CCFFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginBottom="25dp"
            android:textFontWeight="500"
            android:lineHeight="30sp" />

        <!-- QR code + 코너 브래킷 -->
        <FrameLayout
            android:layout_width="232dp"
            android:layout_height="232dp">

            <ImageView
                android:id="@+id/ivQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="20dp"
                android:src="@drawable/ic_qr"
                app:tint="#A5A6F6"
                android:padding="24dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:src="@drawable/ic_corner_tl"
                app:tint="#A5A6F6" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_corner_tr"
                app:tint="#A5A6F6" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|start"
                android:src="@drawable/ic_corner_bl"
                app:tint="#A5A6F6" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_corner_br"
                app:tint="#A5A6F6" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="정산방"
            android:textColor="#AAB2FF"
            android:textSize="18sp"
            android:gravity="center"
            android:textFontWeight="500"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvRoomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026.06.06"
            android:textColor="#AAB2FF"
            android:textSize="16sp"
            android:gravity="center"
            android:textFontWeight="400" />

        <TextView
            android:id="@+id/tvTokenExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="이 QR은 24시간 동안 유효해요"
            android:textColor="#8A8BC4"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRegenerateQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="QR 다시 만들기"
            android:textColor="#BEBEF7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="1" />

        <!-- 이미지 저장 / 공유 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:id="@+id/btnSaveImage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_sky"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_download"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이미지 저장하기"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textFontWeight="400"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnShareQr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_violet"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_share_circle"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR코드 공유하기"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textFontWeight="400"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- 카카오톡으로 초대 -->
        <LinearLayout
            android:id="@+id/btnKakaoShare"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_kakao"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬  카카오톡으로 초대하기"
                android:textColor="#191919"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />

        </LinearLayout>

    </com.android.bilzy.ui.widget.NotchedTicketLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom button -->
    <TextView
        android:id="@+id/btnEnter"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="36dp"
        android:text="정산방 입장하기"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textFontWeight="500"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeMaxTextSize="16sp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <!-- 헤더 구분선 (피그마 Header - TopAppBar: 아래 테두리 #6FA8FF 30%, 제목 아래 18) -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#4D6FA8FF"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
