<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top bar -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:src="@drawable/logo_bilzy"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null"
        android:layout_marginStart="28dp"
        android:layout_marginTop="61dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="직접 입력"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textFontWeight="500"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/roundBadgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_green"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_green" />

            <TextView
                android:id="@+id/tvRoundBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1차"
                android:textColor="#6ADB74"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textFontWeight="600" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="모임 이름과 상세내역을 입력해주세요"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp"
                android:textFontWeight="700" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="나누어야 할 금액과 항목을 정확히 입력하면\n정산이 더 쉬워져요"
                android:textColor="#AAB2FF"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"
                android:textFontWeight="400"
                android:lineHeight="22sp" />

            <!-- 모임 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모임 이름"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etGroupName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="예: 5월 회식"
                android:textColorHint="#5555AA"
                android:textColor="#1A1F3E"
                android:textSize="16sp"
                android:background="@drawable/bg_input_white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:layout_marginBottom="14dp"
                android:textFontWeight="500" />

            <!-- 가게 이름 -->
            <!-- TODO: 가게 이름은 현재 클라이언트에서만 표시되고 서버로 전송되지 않음 — 도메인 모델/백엔드 계약에 필드 추가 필요 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가게 이름"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etStoreName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="가게명"
                android:textColorHint="#5555AA"
                android:textColor="#1A1F3E"
                android:textSize="16sp"
                android:background="@drawable/bg_input_white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:layout_marginBottom="14dp"
                android:textFontWeight="500" />

            <!-- 영수증 내역 label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영수증 내역"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textFontWeight="500"
                android:maxLines="1" />

            <!-- 프로토타입 .bz-ocr-card: 품목 목록/항목 추가/합계를 하나의 카드로 묶는다 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ocr_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="20dp">

                <!-- Items RecyclerView (인라인 편집 셀) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Add item button (dashed) -->
                <TextView
                    android:id="@+id/btnAddItem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:text="⊕  품목 추가"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:background="@drawable/bg_dashed_border"
                    android:clickable="true"
                    android:focusable="true"
                    android:textFontWeight="400" />

                <!-- 합계 구분선 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#24FFFFFF" />

                <!-- Total row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="합계"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textFontWeight="600"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0원"
                        android:textColor="#BFAFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textFontWeight="600" />

                </LinearLayout>

            </LinearLayout>

            <!-- 정확한 입력이 중요한 이유 안내 박스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_tip_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textColor="#A5A6F6"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정확한 입력이 중요한 이유"
                        android:textColor="#AAB2FF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textFontWeight="600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="개별 메뉴와 수량을 입력하면 친구들이\n각자 먹은 것만 정확하게 나눠서 결제할 수 있어요"
                        android:textColor="#D9DCFF"
                        android:textSize="15sp"
                        android:textFontWeight="300"
                        android:lineHeight="22sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom buttons: 완료하기(outline) / 추가 입력하기(purple) -->
    <LinearLayout
        android:id="@+id/bottomButtonsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnComplete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:elevation="5dp"
            android:text="완료하기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_button_ghost"
            android:clickable="true"
            android:focusable="true"
            android:textFontWeight="500"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="16sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:elevation="5dp"
            android:text="추가 입력하기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_button_glass"
            android:clickable="true"
            android:focusable="true"
            android:textFontWeight="500"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="16sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

    </LinearLayout>

    <!-- 헤더 구분선 (피그마 Header - TopAppBar: 아래 테두리 #6FA8FF 30%, 제목 아래 18) -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#4D6FA8FF"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
