<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true"> <!-- 애니메이션 추가: 검색창 사라질 때 부드럽게 -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD YOUR FAVORIE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"/>

        <!-- 카테고리 스피너 영역 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_card_capsule"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <!-- 검색창 영역 컨테이너 -->
        <FrameLayout
            android:id="@+id/layout_search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="16dp">

            <!-- 첫 번째 네온 레이어 (기본) -->
            <ImageView
                android:id="@+id/iv_neon_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_card_shadow"
                android:scaleType="fitXY"
                android:scaleX="1.2"
                android:scaleY="1.3"/>

            <!-- 두 번째 네온 레이어 (광량 추가) -->
            <ImageView
                android:id="@+id/iv_neon_shadow_bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_card_shadow"
                android:scaleType="fitXY"
                android:scaleX="1.2"
                android:scaleY="1.3"/><!-- 70% 농도로 한 겹 더 겹침 -->

            <!-- 2. 실제 흰색 검색창 본체 (그림자 위에 겹쳐짐) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="0dp"
                android:background="@drawable/bg_card_capsule"
                android:backgroundTint="@color/white"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search..."
                    android:background="@null"
                    android:textSize="16sp"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/black" />
            </LinearLayout>
        </FrameLayout>

        <!-- 이미지 업로드 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_image_upload"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@drawable/bg_image_upload"
            android:clipToOutline="true"
            android:layout_marginBottom="24dp">

            <!-- 카테고리별 네온 배경 (FASHION=blue, MOOD=purple) -->
            <ImageView
                android:id="@+id/iv_neon_upload_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 업로드 완료 후 미리보기 이미지 -->
            <ImageView
                android:id="@+id/iv_image_preview_full"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/iv_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add"
                app:tint="#666666"
                app:layout_constraintBottom_toTopOf="@id/tv_upload_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv_upload_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[+ Image / Default Cover]"
                android:textColor="#666666"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_preview" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 코멘트 입력창 -->
        <EditText
            android:id="@+id/et_comment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_card_capsule"
            android:backgroundTint="@color/white"
            android:hint="Write your own taste here..."
            android:paddingHorizontal="20dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginBottom="40dp"/>

        <!-- 추가 버튼 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_item"
            android:layout_width="190dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_card_capsule"
            android:backgroundTint="@color/white"
            android:text="CONFIRM"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>