<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <!-- ==================== AUTH ==================== -->

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.android.bilzy.ui.auth.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment" />
        <action android:id="@+id/action_onboarding_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.android.bilzy.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_login_to_loginLoading"
            app:destination="@id/loginLoadingFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.android.bilzy.ui.auth.SignupFragment"
        android:label="Signup"
        tools:layout="@layout/fragment_signup">
        <!-- 카카오 OAuth(데이터 제공 동의)를 먼저 끝낸 뒤 서비스 약관 동의로 진행 -->
        <action android:id="@+id/action_signup_to_signupKakaoTerms"
            app:destination="@id/signupKakaoTermsFragment" />
    </fragment>

    <!-- 서비스 이용약관·개인정보 동의 게이트(카카오 동의항목과는 별개). 동의 시 가입 완료. -->
    <fragment
        android:id="@+id/signupKakaoTermsFragment"
        android:name="com.android.bilzy.ui.auth.SignupTermsFragment"
        android:label="Terms"
        tools:layout="@layout/fragment_signup_terms">
        <argument
            android:name="is_kakao"
            app:argType="boolean"
            android:defaultValue="true" />
        <action android:id="@+id/action_signupKakaoTerms_to_loginLoading"
            app:destination="@id/loginLoadingFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginLoadingFragment"
        android:name="com.android.bilzy.ui.auth.LoginLoadingFragment"
        android:label="LoginLoading"
        tools:layout="@layout/fragment_login_loading">
        <action android:id="@+id/action_loginLoading_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ==================== MAIN ==================== -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.android.bilzy.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_scanPermission"
            app:destination="@id/scanPermissionFragment" />
        <action android:id="@+id/action_home_to_scanCamera"
            app:destination="@id/scanCameraFragment" />
        <action android:id="@+id/action_home_to_qrScan"
            app:destination="@id/qrScanFragment" />
        <action android:id="@+id/action_home_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_home_to_historyList"
            app:destination="@id/historyListFragment" />
        <action android:id="@+id/action_home_to_historyDetail"
            app:destination="@id/historyDetailWithReceiptFragment" />
        <action android:id="@+id/action_home_to_myPage"
            app:destination="@id/myPageFragment" />
    </fragment>

    <!-- ==================== HISTORY ==================== -->

    <fragment
        android:id="@+id/historyListFragment"
        android:name="com.android.bilzy.ui.history.HistoryListFragment"
        android:label="HistoryList"
        tools:layout="@layout/fragment_history_list">
        <action android:id="@+id/action_historyList_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyList_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_historyList_to_myPage"
            app:destination="@id/myPageFragment" />
        <action android:id="@+id/action_historyList_to_historyDetail"
            app:destination="@id/historyDetailWithReceiptFragment" />
        <action android:id="@+id/action_historyList_to_historyEmpty"
            app:destination="@id/historyEmptyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyEmptyFragment"
        android:name="com.android.bilzy.ui.history.HistoryEmptyFragment"
        android:label="HistoryEmpty"
        tools:layout="@layout/fragment_history_empty">
        <action android:id="@+id/action_historyEmpty_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyEmpty_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_historyEmpty_to_myPage"
            app:destination="@id/myPageFragment" />
        <action android:id="@+id/action_historyEmpty_to_historyDetail"
            app:destination="@id/historyDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyDetailFragment"
        android:name="com.android.bilzy.ui.history.HistoryDetailFragment"
        android:label="HistoryDetail"
        tools:layout="@layout/fragment_history_detail">
        <argument
            android:name="settlementId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action android:id="@+id/action_historyDetail_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyDetail_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_historyDetail_to_historyList"
            app:destination="@id/historyListFragment"
            app:popUpTo="@id/historyListFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyDetail_to_myPage"
            app:destination="@id/myPageFragment" />
        <action android:id="@+id/action_historyDetail_to_receiptPicker"
            app:destination="@id/receiptPickerFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyDetailWithReceiptFragment"
        android:name="com.android.bilzy.ui.history.HistoryDetailWithReceiptFragment"
        android:label="HistoryDetailWithReceipt"
        tools:layout="@layout/fragment_history_detail_with_receipt">
        <argument
            android:name="settlementId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action android:id="@+id/action_historyDetailWithReceipt_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyDetailWithReceipt_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_historyDetailWithReceipt_to_historyList"
            app:destination="@id/historyListFragment"
            app:popUpTo="@id/historyListFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_historyDetailWithReceipt_to_myPage"
            app:destination="@id/myPageFragment" />
        <action android:id="@+id/action_historyDetailWithReceipt_to_receiptPicker"
            app:destination="@id/receiptPickerFragment" />
    </fragment>

    <fragment
        android:id="@+id/receiptPickerFragment"
        android:name="com.android.bilzy.ui.history.ReceiptPickerFragment"
        android:label="ReceiptPicker"
        tools:layout="@layout/fragment_receipt_picker">
        <action android:id="@+id/action_receiptPicker_to_historyDetailWithReceipt"
            app:destination="@id/historyDetailWithReceiptFragment"
            app:popUpTo="@id/historyDetailFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_receiptPicker_to_scanHub"
            app:destination="@id/scanHubFragment" />
    </fragment>

    <!-- ==================== MY PAGE ==================== -->

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.android.bilzy.ui.mypage.MyPageFragment"
        android:label="MyPage"
        tools:layout="@layout/fragment_my_page">
        <action android:id="@+id/action_myPage_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_myPage_to_scanHub"
            app:destination="@id/scanHubFragment" />
        <action android:id="@+id/action_myPage_to_historyList"
            app:destination="@id/historyListFragment" />
        <action android:id="@+id/action_myPage_to_myPageAccount"
            app:destination="@id/myPageAccountFragment" />
        <action android:id="@+id/action_myPage_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/myPageAccountFragment"
        android:name="com.android.bilzy.ui.mypage.MyPageAccountFragment"
        android:label="MyPageAccount"
        tools:layout="@layout/fragment_my_page_account" />

    <!-- ==================== SCAN ==================== -->

    <fragment
        android:id="@+id/scanHubFragment"
        android:name="com.android.bilzy.ui.scan.ScanHubFragment"
        android:label="ScanHub"
        tools:layout="@layout/fragment_scan_hub">
        <action android:id="@+id/action_scanHub_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_scanHub_to_scanCameraModal"
            app:destination="@id/scanCameraModalFragment" />
        <action android:id="@+id/action_scanHub_to_enteringRoom"
            app:destination="@id/enteringRoomFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanPermissionFragment"
        android:name="com.android.bilzy.ui.scan.ScanPermissionFragment"
        android:label="ScanPermission"
        tools:layout="@layout/fragment_scan_permission">
        <action android:id="@+id/action_scanPermission_to_scanCamera"
            app:destination="@id/scanCameraFragment" />
        <action android:id="@+id/action_scanPermission_to_manualInput"
            app:destination="@id/manualInputFragment" />
        <action android:id="@+id/action_scanPermission_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_scanPermission_to_historyList"
            app:destination="@id/historyListFragment" />
        <action android:id="@+id/action_scanPermission_to_myPage"
            app:destination="@id/myPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanCameraFragment"
        android:name="com.android.bilzy.ui.scan.ScanCameraFragment"
        android:label="ScanCamera"
        tools:layout="@layout/fragment_scan_camera">
        <action android:id="@+id/action_scanCamera_to_back"
            app:destination="@id/scanPermissionFragment"
            app:popUpTo="@id/scanPermissionFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_scanCamera_to_modal"
            app:destination="@id/scanCameraModalFragment" />
        <action android:id="@+id/action_scanCamera_to_qrScan"
            app:destination="@id/qrScanFragment" />
    </fragment>

    <dialog
        android:id="@+id/scanCameraModalFragment"
        android:name="com.android.bilzy.ui.scan.ScanCameraModalFragment"
        android:label="ScanCameraModal"
        tools:layout="@layout/fragment_scan_camera_modal">
        <action android:id="@+id/action_modal_to_recognizing"
            app:destination="@id/recognizingFragment"
            app:popUpTo="@id/scanCameraFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_modal_dismiss"
            app:popUpTo="@id/scanCameraFragment"
            app:popUpToInclusive="false" />
    </dialog>

    <fragment
        android:id="@+id/recognizingFragment"
        android:name="com.android.bilzy.ui.scan.RecognizingFragment"
        android:label="Recognizing"
        tools:layout="@layout/fragment_recognizing">
        <!-- 인식 완료 → 영수증 저장 확인 (뒤로가기 시 재업로드 방지 위해 recognizing 제거) -->
        <action android:id="@+id/action_recognizing_to_receiptSave"
            app:destination="@id/receiptSaveFragment"
            app:popUpTo="@id/recognizingFragment"
            app:popUpToInclusive="true" />
        <!-- OCR 업로드 성공 → 결과 확인 화면 (뒤로가기 시 재업로드 방지 위해 recognizing 제거) -->
        <action android:id="@+id/recognizing_to_ocrResult"
            app:destination="@id/ocrResultFragment"
            app:popUpTo="@id/recognizingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/receiptSaveFragment"
        android:name="com.android.bilzy.ui.scan.ReceiptSaveFragment"
        android:label="ReceiptSave"
        tools:layout="@layout/fragment_receipt_save">
        <action android:id="@+id/action_receiptSave_to_scanCamera"
            app:destination="@id/scanCameraFragment"
            app:popUpTo="@id/scanCameraFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_receiptSave_to_saved"
            app:destination="@id/receiptSavedFragment" />
    </fragment>

    <fragment
        android:id="@+id/receiptSavedFragment"
        android:name="com.android.bilzy.ui.scan.ReceiptSavedFragment"
        android:label="ReceiptSaved"
        tools:layout="@layout/fragment_receipt_saved">
        <!-- 저장 완료 → OCR 결과 (저장 화면 2개를 백스택에서 정리) -->
        <action android:id="@+id/action_receiptSaved_to_ocrResult"
            app:destination="@id/ocrResultFragment"
            app:popUpTo="@id/receiptSaveFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/ocrResultFragment"
        android:name="com.android.bilzy.ui.settlement.OcrResultFragment"
        android:label="OcrResult"
        tools:layout="@layout/fragment_ocr_result">
        <action android:id="@+id/action_ocrResult_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_ocrResult_to_addItem"
            app:destination="@id/addItemFragment" />
        <action android:id="@+id/action_ocrResult_to_peopleCount"
            app:destination="@id/peopleCountFragment" />
    </fragment>

    <fragment
        android:id="@+id/manualInputFragment"
        android:name="com.android.bilzy.ui.settlement.ManualInputFragment"
        android:label="ManualInput"
        tools:layout="@layout/fragment_manual_input">
        <action android:id="@+id/action_manualInput_to_back"
            app:destination="@id/scanPermissionFragment"
            app:popUpTo="@id/scanPermissionFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_manualInput_to_addItem"
            app:destination="@id/addItemFragment" />
        <action android:id="@+id/action_manualInput_to_peopleCount"
            app:destination="@id/peopleCountFragment" />
    </fragment>

    <fragment
        android:id="@+id/addItemFragment"
        android:name="com.android.bilzy.ui.settlement.AddItemFragment"
        android:label="AddItem"
        tools:layout="@layout/fragment_add_item">
        <action android:id="@+id/action_addItem_to_back"
            app:popUpTo="@id/ocrResultFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/peopleCountFragment"
        android:name="com.android.bilzy.ui.settlement.PeopleCountFragment"
        android:label="PeopleCount"
        tools:layout="@layout/fragment_people_count">
        <action android:id="@+id/action_peopleCount_to_back"
            app:popUpTo="@id/ocrResultFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_peopleCount_to_participantInput"
            app:destination="@id/participantInputFragment" />
    </fragment>

    <fragment
        android:id="@+id/participantInputFragment"
        android:name="com.android.bilzy.ui.settlement.ParticipantInputFragment"
        android:label="ParticipantInput"
        tools:layout="@layout/fragment_participant_input">
        <action android:id="@+id/action_participantInput_to_back"
            app:destination="@id/peopleCountFragment"
            app:popUpTo="@id/peopleCountFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_participantInput_to_qrInvite"
            app:destination="@id/qrInviteFragment" />
    </fragment>

    <fragment
        android:id="@+id/qrInviteFragment"
        android:name="com.android.bilzy.ui.settlement.QrInviteFragment"
        android:label="QrInvite"
        tools:layout="@layout/fragment_qr_invite">
        <action android:id="@+id/action_qrInvite_to_back"
            app:destination="@id/participantInputFragment"
            app:popUpTo="@id/participantInputFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_qrInvite_to_enteringRoom"
            app:destination="@id/enteringRoomFragment" />
    </fragment>

    <fragment
        android:id="@+id/qrScanFragment"
        android:name="com.android.bilzy.ui.scan.QrScanFragment"
        android:label="QrScan"
        tools:layout="@layout/fragment_qr_scan">
        <action android:id="@+id/action_qrScan_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_qrScan_to_enteringRoom"
            app:destination="@id/enteringRoomFragment" />
        <action android:id="@+id/action_qrScan_to_scanCamera"
            app:destination="@id/scanCameraFragment" />
    </fragment>

    <!-- ==================== ROOM ==================== -->

    <!-- 초대 딥링크(bilzy://join/{id}) 입장 확인 게이트 — 외부 진입점, 자동 가입 금지 -->
    <fragment
        android:id="@+id/joinConfirmFragment"
        android:name="com.android.bilzy.ui.room.JoinConfirmFragment"
        android:label="JoinConfirm"
        tools:layout="@layout/fragment_join_confirm">
        <argument
            android:name="settlementId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action android:id="@+id/action_joinConfirm_to_enteringRoom"
            app:destination="@id/enteringRoomFragment"
            app:popUpTo="@id/joinConfirmFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_joinConfirm_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/joinConfirmFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/enteringRoomFragment"
        android:name="com.android.bilzy.ui.room.EnteringRoomFragment"
        android:label="EnteringRoom"
        tools:layout="@layout/fragment_entering_room">
        <action android:id="@+id/action_enteringRoom_to_memberWaiting"
            app:destination="@id/memberWaitingFragment" />
    </fragment>

    <fragment
        android:id="@+id/memberWaitingFragment"
        android:name="com.android.bilzy.ui.room.MemberWaitingFragment"
        android:label="MemberWaiting"
        tools:layout="@layout/fragment_member_waiting">
        <action android:id="@+id/action_memberWaiting_to_amountAdjust"
            app:destination="@id/amountAdjustFragment" />
    </fragment>

    <fragment
        android:id="@+id/amountAdjustFragment"
        android:name="com.android.bilzy.ui.room.AmountAdjustFragment"
        android:label="AmountAdjust"
        tools:layout="@layout/fragment_amount_adjust">
        <action android:id="@+id/action_amountAdjust_to_back"
            app:destination="@id/memberWaitingFragment"
            app:popUpTo="@id/memberWaitingFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_amountAdjust_to_calculating"
            app:destination="@id/calculatingFragment" />
    </fragment>

    <fragment
        android:id="@+id/calculatingFragment"
        android:name="com.android.bilzy.ui.room.CalculatingFragment"
        android:label="Calculating"
        tools:layout="@layout/fragment_calculating">
        <action android:id="@+id/action_calculating_to_settlementResult"
            app:destination="@id/settlementResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/settlementResultFragment"
        android:name="com.android.bilzy.ui.room.SettlementResultFragment"
        android:label="SettlementResult"
        tools:layout="@layout/fragment_settlement_result">
        <action android:id="@+id/action_settlementResult_to_back"
            app:destination="@id/calculatingFragment"
            app:popUpTo="@id/calculatingFragment"
            app:popUpToInclusive="false" />
        <action android:id="@+id/action_settlementResult_to_complete"
            app:destination="@id/settlementCompleteFragment" />
    </fragment>

    <fragment
        android:id="@+id/settlementCompleteFragment"
        android:name="com.android.bilzy.ui.room.SettlementCompleteFragment"
        android:label="SettlementComplete"
        tools:layout="@layout/fragment_settlement_complete">
        <action android:id="@+id/action_settlementComplete_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

</navigation>
