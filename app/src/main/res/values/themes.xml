<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bilzy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 피그마(UI 4차) 서체: 앱 전체 기본 글꼴을 Pretendard로 -->
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
    </style>

    <!-- 팝업 메뉴(정산내역 사진의 ⋯)를 앱 톤으로: 어두운 카드 + 흰 글자. 기본값은 흰 배경이라 화면과 따로 놀았다. -->
    <style name="ThemeOverlay.Bilzy.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <item name="popupMenuStyle">@style/Widget.Bilzy.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Bilzy.PopupMenu</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="Widget.Bilzy.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_terms_dialog</item>
    </style>

    <!-- 정산내역 상세 영수증 ⋯ 메뉴 항목 (popup_receipt_menu.xml) -->
    <style name="ReceiptMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_receipt_menu_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ReceiptMenuIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ReceiptMenuText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 런치(스플래시) 테마: 네이비 배경 + 중앙 로고. onCreate에서 Theme.Bilzy로 전환. -->
    <style name="Theme.Bilzy.Splash" parent="Theme.Bilzy">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
