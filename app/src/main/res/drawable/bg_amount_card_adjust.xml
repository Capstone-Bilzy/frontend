<?xml version="1.0" encoding="utf-8"?>
<!-- 금액조정 화면 전용 금액 카드: bg_amount_card보다 더 투명하게(알파 낮춰 뒤 배경이 비치고 어둡게 보이도록) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#66514BC4"
                android:endColor="#66322B85" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:color="#80A5A6F6" android:width="1.5dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
