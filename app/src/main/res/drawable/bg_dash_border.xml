<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 배경색 (보라색 계열로 설정) -->
    <solid android:color="#C026D3" />

    <!-- 점선 테두리 설정 -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF"
        android:dashWidth="8dp"
        android:dashGap="4dp" />

    <!-- 둥근 모서리 (카드와 동일하게) -->
    <corners android:radius="30dp" />
</shape>