<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted purple gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#B3514BC4"
                android:endColor="#B3322B85" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Frosted white veil -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Lavender glass border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:color="#80A5A6F6" android:width="1.5dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
