<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent violet-purple gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#739A52D8"
                android:endColor="#4D4A2A8A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Frosted white veil -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Lavender glass border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:color="#80A5A6F6" android:width="1.5dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
