<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 배경: 중간 밝기 인디고 (배경 #030B46과 뚜렷하게 구분) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EE181564" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>

    <!-- 상단 shimmer 테두리 -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:color="#66FFFFFF" android:width="1dp" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>

</layer-list>
